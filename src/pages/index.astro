---
import CategoryPosts from '../components/CategoryPosts.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WP Astro Islands Prototype</title>
  </head>
  <body>
    <!--
      The body contains ONLY the island (plus the runtime Astro injects for it),
      so the WordPress plugin's shortcode can lift the body's inner HTML verbatim
      and drop it into an Elementor widget. `client:load` hydrates it in the
      browser, where it fetches the custom feed route at runtime. No post data is
      baked into this HTML at build time.
    -->
    <CategoryPosts client:load />
  </body>
</html>

<style is:global>
  :root {
    font-family:
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      sans-serif;
    color: #1a1a1a;
  }

  /* Layout lives on the island's own wrapper so the styling travels with the
     component when embedded, rather than depending on page chrome. */
  .wcr-islands {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .wcr-islands .category__title {
    font-size: 1.4rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e5e5e5;
  }

  .wcr-islands .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .wcr-islands .post-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .wcr-islands .post-card__thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
    background: #f0f0f0;
    display: block;
  }

  .wcr-islands .post-card__thumb--empty {
    border: 1px dashed #d0d0d0;
  }

  .wcr-islands .post-card__title {
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0.6rem 0 0.3rem;
  }

  .wcr-islands .post-card__date {
    display: block;
    font-size: 0.8rem;
    color: #777;
    margin-bottom: 0.4rem;
  }

  .wcr-islands .post-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.45;
    color: #444;
    margin: 0;
  }

  .wcr-islands .island-status {
    color: #555;
    font-style: italic;
  }

  .wcr-islands .island-status--error {
    color: #b00020;
    font-style: normal;
  }
</style>
