---
import CategoryPosts from '../components/CategoryPosts.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WP Astro Islands Prototype</title>
  </head>
  <body>
    <main class="wrap">
      <h1>Recent Posts</h1>
      <!--
        The island host. `client:load` hydrates it in the browser, where it
        fetches the WordPress REST API at runtime. No post data is baked into
        this HTML at build time.
      -->
      <CategoryPosts client:load />
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      system-ui,
      -apple-system,
      Segoe UI,
      Roboto,
      sans-serif;
    color: #1a1a1a;
  }

  body {
    margin: 0;
    background: #fff;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 1.5rem;
  }

  .categories {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category__title {
    font-size: 1.4rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e5e5e5;
  }

  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .post-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-card__thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
    background: #f0f0f0;
    display: block;
  }

  .post-card__thumb--empty {
    border: 1px dashed #d0d0d0;
  }

  .post-card__title {
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0.6rem 0 0.3rem;
  }

  .post-card__date {
    display: block;
    font-size: 0.8rem;
    color: #777;
    margin-bottom: 0.4rem;
  }

  .post-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.45;
    color: #444;
    margin: 0;
  }

  .island-status {
    color: #555;
    font-style: italic;
  }

  .island-status--error {
    color: #b00020;
    font-style: normal;
  }
</style>
