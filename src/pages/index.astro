---
import CategoryPosts from '../components/CategoryPosts.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WP Astro Islands Prototype</title>
  </head>
  <body>
    <!--
      The body contains ONLY the island (plus the runtime Astro injects for it),
      so the WordPress plugin's shortcode can lift the body's inner HTML verbatim
      and drop it into an Elementor widget. `client:load` hydrates it in the
      browser, where it attaches a shadow root, injects its own CSS, and fetches
      the custom feed route at runtime. No post data is baked in at build time.
    -->
    <h1>Static Landing Page</h1>
    <p>This is a static landing page that displays the latest posts from the WordPress site.</p>
    <CategoryPosts client:load />
  </body>
</html>
